# Demo mode is the safe default. Real integrations are never silently simulated.
DEMO_MODE=true
LOCAL_TRUSTED_ACCESS=false
DATABASE_URL=./data/baoyan-prep.db
UPLOAD_DIR=./data/uploads
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ACCESS_CODE=replace-before-public-real-mode

# DeepSeek API (server-only; the UI can also provide per-browser keys)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# Server-only search and page extraction
TAVILY_API_KEY=
