# Demo mode is the safe default. Real integrations are never silently simulated.
DEMO_MODE=true
DATABASE_URL=./data/baoyan-prep.db
UPLOAD_DIR=./data/uploads
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ACCESS_CODE=replace-before-public-real-mode

# OpenAI-compatible Chat Completions endpoint (server-only)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Server-only search and page extraction
TAVILY_API_KEY=
